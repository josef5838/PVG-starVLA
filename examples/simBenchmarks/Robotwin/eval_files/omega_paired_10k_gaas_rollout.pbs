#!/usr/bin/env bash
#PBS -N omega_eval_10k
#PBS -P gs_ccds_chuanxia.zheng
#PBS -q gpu_as
#PBS -l select=1:ncpus=12:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail
source "${OMEGA_BUNDLE:?}/configured/environment.sh"
cd "${OMEGA_STUDY:?}/source"
export PYTHONPATH="$PWD:$OMEGA_BUNDLE/runtime_site:${PYTHONPATH:-}"
export STARVLA_FRAMEWORK_MODULES=starVLA.model.framework.VLM4A.OmegaCameraStreamDiT
unset DISPLAY
nvidia-smi > "$OMEGA_STUDY/gpu_${OMEGA_VARIANT:?}_at_start.txt"
exec /home/n2506021c/miniconda3/envs/surflo-dit-cu124/bin/python \
    tools/run_omega_paired_rollouts_gaas.py --study "$OMEGA_STUDY" --variant "$OMEGA_VARIANT" \
    > "$OMEGA_STUDY/pbs_${OMEGA_VARIANT}_runner.log" 2>&1
